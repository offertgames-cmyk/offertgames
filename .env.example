# ==========================================
# OffertGames - Configuración de Firebase y Autenticación
# ==========================================
# Obtén estas claves en https://console.firebase.google.com
# Proyecto -> Configuración del proyecto (Project Settings) -> General -> Tus apps (Web)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=offertgames-xxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=offertgames-xxxx
VITE_FIREBASE_STORAGE_BUCKET=offertgames-xxxx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Apps Script web app URL used to send and validate Google email verification codes
VITE_GOOGLE_OTP_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# (Opcional si usas Supabase alternativo)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==========================================
# IsThereAnyDeal API (Clave Secreta en Servidor - NUNCA visible en cliente)
# ==========================================
# Regístrate y obtén tu clave API gratis en: https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# ==========================================
# Envío de Notificaciones por Correo Electrónico (Opcional)
# ==========================================
# Configura un servidor SMTP o Resend API para enviar emails automáticos:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu_contraseña_de_aplicacion
# RESEND_API_KEY=re_xxxxxxxxx


